# Demo/repro HOME for the batch-settlement runs. Everything under it is
# local wallet state, including plaintext ephemeral secret keys in
# .config/pay/accounts.yml; only the paywall config is safe to track.
/.home/*
!/.home/batch-only.yaml
!/.home/market-gate.yaml

# Agent skill install, written by the skill installer into the rust workspace.
